{
  "name": "science-quest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only database,auth --project demo-science-quest \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only database,auth --project demo-science-quest",
    "dev:local": "VITE_BACKEND=local vite",
    "local-server": "node devserver/server.mjs",
    "deploy:rules": "firebase deploy --only database",
    "e2e": "node tests/e2e/run.mjs",
    "build:demo": "VITE_BACKEND=demo vite build --mode demo"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.19.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.74.0",
    "papaparse": "^5.7.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "firebase-tools": "^15.36.0",
    "postcss": "^8.5.33",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}